# Postgres connection string. Requires the btree_gist extension (schema.sql enables it).
DATABASE_URL=postgres://user:password@localhost:5432/whatsapp_booking

# Twilio (WhatsApp Business API). Get these from console.twilio.com after
# requesting WhatsApp access for your number. See task 1.2 in tasks.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Exact public URL Twilio POSTs the webhook to (used to verify the
# X-Twilio-Signature header). Required if you're behind a proxy/load
# balancer that rewrites the host, since the request Next.js sees may not
# match what Twilio actually called.
TWILIO_WEBHOOK_URL=https://your-domain.example.com/api/whatsapp/webhook

# Plain SMS number (not WhatsApp) used only for host-directed notifications
# (needs-reply, upcoming check-in) — see design.md for why these are SMS,
# not WhatsApp, to the host.
TWILIO_SMS_NUMBER=+14155550123

# Content SIDs for the approved WhatsApp templates (Twilio console, after
# Meta approves them — see tasks.md 1.2). Leave unset during early dev: guest
# scheduled messages fall back to free-form text, which only actually
# delivers within 24h of the guest's last message.
TWILIO_TEMPLATE_PRE_ARRIVAL_REMINDER=
TWILIO_TEMPLATE_CHECKIN_INSTRUCTIONS=

# LLM used only for FAQ fallback replies (never for booking decisions).
ANTHROPIC_API_KEY=

# Secret used to sign host session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret the cron trigger must send to POST /api/cron/send-scheduled
CRON_SECRET=
